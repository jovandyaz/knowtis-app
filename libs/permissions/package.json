{
  "name": "@jovandyaz/permissions",
  "version": "0.1.0",
  "description": "Framework-agnostic, type-safe permissions library with React and NestJS integrations",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "dependencies": {
    "@casl/ability": "^6.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./src/react.d.ts"
      ],
      "nestjs": [
        "./src/nestjs.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./nestjs": {
      "types": "./src/nestjs.d.ts",
      "import": "./src/nestjs.js",
      "default": "./src/nestjs.js"
    }
  },
  "sideEffects": false
}
