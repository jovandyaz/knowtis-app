{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@knowtis/design-system": ["libs/design-system/src/index.ts"],
      "@knowtis/shared-hooks": ["libs/shared/hooks/src/index.ts"],
      "@knowtis/shared-util": ["libs/shared/util/src/index.ts"],
      "@knowtis/data-access-notes": ["libs/data-access/notes/src/index.ts"],
      "@knowtis/data-access-users": ["libs/data-access/users/src/index.ts"],
      "@knowtis/data-access-mcp-keys": [
        "libs/data-access/mcp-keys/src/index.ts"
      ],
      "@knowtis/data-access-feature-flags": [
        "libs/data-access/feature-flags/src/index.ts"
      ],
      "@knowtis/shared-i18n": ["libs/shared/i18n/src/index.ts"],
      "@knowtis/shared-types": ["libs/shared/types/src/index.ts"],
      "@knowtis/api-client": ["libs/api-client/src/index.ts"],
      "@knowtis/authorization": ["libs/authorization/src/index.ts"],
      "@jovandyaz/permissions-core": ["packages/permissions/src/index.ts"],
      "@jovandyaz/permissions-react": [
        "packages/permissions-react/src/index.ts"
      ],
      "@jovandyaz/permissions-nestjs": [
        "packages/permissions-nestjs/src/index.ts"
      ],
      "@jovandyaz/auth": ["packages/auth/src/index.ts"],
      "@jovandyaz/auth/server": ["packages/auth/src/server.ts"],
      "@jovandyaz/auth-react": ["packages/auth-react/src/index.ts"],
      "@jovandyaz/auth-nestjs": ["packages/auth-nestjs/src/index.ts"],
      "@jovandyaz/email": ["packages/email/src/index.ts"],
      "@jovandyaz/email-nestjs": ["packages/email-nestjs/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
