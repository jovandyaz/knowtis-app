{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
    // After config:recommended on purpose: later preset wins.
    ':semanticCommitTypeAll(chore)',
    ':maintainLockFilesWeekly',
    'helpers:pinGitHubActionDigests',
    'group:jsTest',
    'group:definitelyTyped',
    'group:pnpm',
  ],
  timezone: 'America/Mexico_City',
  schedule: ['* 0-5 * * 1'],
  labels: ['dependencies'],
  rangeStrategy: 'bump',
  prHourlyLimit: 0,
  prConcurrentLimit: 5,
  platformAutomerge: true,
  automergeStrategy: 'squash',
  lockFileMaintenance: { automerge: true },
  // Security PRs have their own budget; unbounded they exceed the hosted 30 min job.
  vulnerabilityAlerts: { addLabels: ['security'], prConcurrentLimit: 5 },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Peer ranges describe compatibility and are widened, never bumped',
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'widen',
    },
    {
      description: 'Lint and format tooling (explicit list: group:linters would also capture @nx/eslint-plugin and break the Nx lockstep)',
      matchPackageNames: [
        'eslint',
        '@eslint/**',
        'eslint-plugin-**',
        'eslint-config-**',
        'typescript-eslint',
        '@typescript-eslint/**',
        'jsonc-eslint-parser',
        'prettier',
        '@ianvs/prettier-plugin-sort-imports',
      ],
      groupName: 'linters',
    },
    {
      description: 'Nx and its plugins share one version and are upgraded with nx migrate, which the hosted app cannot run; approve from the dashboard and follow the PR notes',
      matchPackageNames: ['nx', '@nx/**'],
      groupName: 'nx monorepo',
      dependencyDashboardApproval: true,
      prBodyNotes: [
        '> **Nx upgrade** — do not merge as-is. On this branch run `pnpm nx migrate latest`, `pnpm install`, `pnpm nx migrate --run-migrations`, then commit the result (and delete `migrations.json`). See https://nx.dev/docs/features/automate-updating-dependencies',
      ],
    },
    {
      description: 'NestJS first-party packages released outside nestjs/nest (the core is grouped by the monorepo preset)',
      matchPackageNames: ['@nestjs/**'],
      groupName: 'nestjs extras',
    },
    {
      description: 'Yjs runtime and its ProseMirror bindings',
      matchPackageNames: ['yjs', 'y-prosemirror', 'y-protocols', 'lib0'],
      groupName: 'yjs',
    },
    {
      description: 'Drizzle ORM and kit ship in lockstep',
      matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
      groupName: 'drizzle',
    },
    {
      description: 'AI SDK core and providers',
      matchPackageNames: ['ai', '@ai-sdk/**', '@openrouter/**'],
      groupName: 'ai sdk',
    },
    {
      description: 'Storybook packages',
      matchPackageNames: ['storybook', '@storybook/**'],
      groupName: 'storybook',
    },
    {
      description: 'The Node line is moved by hand: .nvmrc, engines and setup-node declare only the major on purpose (Railway and Vercel track it) and Renovate would pin them to a patch',
      matchDepNames: ['node'],
      enabled: false,
    },
    {
      description: 'A Postgres major is a data migration on Railway, done deliberately',
      matchPackageNames: ['pgvector/pgvector'],
      enabled: false,
    },
    {
      description: 'Majors wait for a checkbox on the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Automerge low-risk dev-only updates once CI is green',
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '!/^0/',
      automerge: true,
    },
    {
      description: 'GitHub Actions digest bumps are safe to automerge',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest', 'pin', 'pinDigest'],
      automerge: true,
    },
  ],
}
