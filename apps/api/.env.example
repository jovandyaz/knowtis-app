# ----------------------------------------------------------------------------
# DATABASE (local)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Default: Uses docker-compose defaults (user: knowtis, pass: knowtis_dev)
DATABASE_URL=postgresql://knowtis:knowtis_dev@localhost:5432/knowtis

# ----------------------------------------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------------------------------------
# Secret keys for JWT tokens. Generate each with: openssl rand -base64 48
# Placeholder-looking values are rejected in production, and the two secrets
# must be different from each other.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor for password hashing (10-15, default 12)
# BCRYPT_ROUNDS=12

# Keys the HMAC over every stored token hash (sessions, reset and verification
# tokens, the 6-digit code). Introducing it invalidates every hash already
# stored, exactly as rotating it does: the deploy that first sets this logs
# every user out and kills every outstanding reset and verification link.
# Replace the placeholder in production: openssl rand -base64 32
TOKEN_HASH_KEY=changemechangemechangemechangemechangemecha=

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
# Server port
PORT=3333

# Environment mode: development | production | test
NODE_ENV=development

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Frontend URL for CORS (must match the frontend origin)
FRONTEND_URL=http://localhost:4200

# Backoffice origin: CORS allow-list + its own refresh cookie. Required in production.
BACKOFFICE_URL=http://localhost:4400

# ----------------------------------------------------------------------------
# REDIS (Optional in single-instance dev; required for multi-instance)
# ----------------------------------------------------------------------------
# Redis connection string. Used by:
#   - Caching and sessions
#   - Hocuspocus extension-redis: enables multi-instance collaboration sync.
#     Without REDIS_URL, Hocuspocus runs in single-instance mode (dev-only).
# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# VERCEL (CI deploy only)
# ----------------------------------------------------------------------------
# These are used by GitHub Actions to deploy the frontend
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=team_xxx
# VERCEL_PROJECT_ID=prj_xxx

# ----------------------------------------------------------------------------
# EMAIL
# ----------------------------------------------------------------------------
# Email provider: 'resend' (production) | 'console' (development, logs only)
EMAIL_PROVIDER=console

# Resend API key (required when EMAIL_PROVIDER=resend)
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx

# Default sender address
EMAIL_FROM=Knowtis <noreply@mail.knowtis.app>

# ----------------------------------------------------------------------------
# AI Configuration
# ----------------------------------------------------------------------------
# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API Keys). When set,
# all provider traffic routes through the gateway and the direct keys below are unused.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Default, fast, and fallback-chain models resolve from code defaults (AI_SETTING_DEFAULTS) plus DB overrides — configure them from the backoffice AI Config page, not here.
# Optional: override the model the copilot eval harness drives (nx run api:eval). Defaults to the agent's code default model.
# Only swaps the driven model; the llm-rubric grader stays on Anthropic, so ANTHROPIC_API_KEY is always required.
AI_EVAL_MODEL=
# Optional: trials per promptfoo eval case (default 1). A case fails when it passes fewer than
# ceil(2/3 * trials) trials. Nightly CI runs 3; keep 1 locally for cheap pre-merge runs.
AI_EVAL_TRIALS=
# Optional: directory where eval runs persist results (promptfoo native JSON + <suite>.summary.json
# per suite, plus vitest.json). Unset = nothing is written. Nightly CI sets it and uploads the dir.
AI_EVAL_OUTPUT_DIR=
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_COST_LIMIT_USD=1.00
# Fraction (0..1) of the daily limits granted to anonymous users
AI_ANONYMOUS_DAILY_LIMIT_PCT=0.33
AI_MAX_RETRIES=3
# Per-user rate limiting: requests per minute and concurrent streaming sessions
AI_RPM_LIMIT=15
AI_MAX_CONCURRENT_STREAMS=2
# Circuit breaker: failures per minute that start a provider cooldown, and its duration
AI_COOLDOWN_ALLOWED_FAILS=3
AI_COOLDOWN_SECONDS=120
# Voice transcription model (only openai:<model> is supported); cost is billed
# per second of audio from the model catalog
AI_TRANSCRIPTION_MODEL=openai:whisper-1
# Optional webhook for AI alerts (budget.warning, cooldown_start) — POST JSON, fire-and-forget
# AI_ALERT_WEBHOOK_URL=https://hooks.example.com/ai-alerts
# Agent health alerts (flag agent_health_alerts, daily cron): alert when the 24h tool error
# rate or anomalous stop-reason rate crosses these fractions (0..1) with >= 20 samples.
# Alerts POST to AI_ALERT_WEBHOOK_URL.
AGENT_TOOL_ERROR_ALERT_RATE=
AGENT_STOP_ANOMALY_ALERT_RATE=
AI_TIMEOUT_MS=30000
# Total streaming cap (ms). Generous on purpose — long generations (learn-topic,
# expand) legitimately run well past the REST timeout; chunkMs guards stalls.
AI_STREAM_MAX_MS=180000
# Refresh model pricing from LiteLLM's public JSON at boot (falls back to the
# vendored snapshot in @knowtis/ai-gateway on failure)
AI_PRICING_REFRESH_ENABLED=false
AI_STREAM_CHUNK_TIMEOUT_MS=10000
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_ENABLED=true
# Copilot agent: max tool-calling steps per turn, max output tokens per turn,
# and max conversation messages loaded from history
AI_AGENT_MAX_STEPS=8
# Budget for the first stream part to arrive; below AI_AGENT_STALL_MS
AI_AGENT_TTFT_MS=30000
# Abort a turn candidate after this much stream silence (any part counts as activity)
AI_AGENT_STALL_MS=60000
# Absolute wall-clock ceiling per turn (backstop, not the operative budget)
AI_AGENT_MAX_MS=300000
AI_AGENT_MAX_OUTPUT_TOKENS=8192
# Ceiling on accumulated inputTokens + outputTokens per turn; once spent, the
# loop stops continuing to the next step instead of over-running the turn.
# Anonymous turns are further clamped to the anonymous daily allowance
# (AI_DAILY_TOKEN_LIMIT * AI_ANONYMOUS_DAILY_LIMIT_PCT) so one turn can never
# exceed what that user may spend in a day
AI_AGENT_TURN_TOKEN_BUDGET=150000
# Rows, not turns: a tool-using turn writes 3–5 rows
AI_AGENT_HISTORY_LIMIT=120
# TTL (seconds) for a pending HITL mutation proposal before it expires in Redis
AI_AGENT_PROPOSAL_TTL_SECONDS=600
# Copilot long-term memory (A6b). Extraction runs only when the agent_longterm_memory
# flag is ON and VOYAGE_API_KEY is set. Registered users only.
AI_MEMORY_QUIET_SECONDS=180
AI_MEMORY_BATCH_SIZE=20
AI_MEMORY_MAX_PER_USER=100
AI_MEMORY_RETRIEVAL_K=6
AI_MEMORY_SIMILARITY_MIN=0.2

# ----------------------------------------------------------------------------
# ADMIN SEEDING (for seed-admin script only)
# ----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=YourSecurePassword123

# Vercel Blob (image uploads) — create a Blob store in the Vercel dashboard and paste its token
VERCEL_BLOB_READ_WRITE_TOKEN=

# Langfuse (LLM tracing for the copilot agent) — create a project at cloud.langfuse.com.
# Optional: omit the keys to disable tracing. Use a DEV project locally; set the PROD
# project keys in Railway, NOT in this file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Voyage embeddings (copilot hybrid retrieval / A3). Without VOYAGE_API_KEY the
# agent_hybrid_retrieval flag must stay off (search degrades to keyword-only).
VOYAGE_API_KEY=
AI_EMBEDDING_MODEL=voyage-4

# Web search for the copilot agent (Tavily). Optional; the agent_web_search flag must also be on.
TAVILY_API_KEY=
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_DEPTH=basic
# 0 = plan with included monthly credits (Researcher). Set to the per-credit rate when billing usage.
AI_WEB_SEARCH_PRICE_PER_CREDIT_USD=0

# BYOK (bring-your-own-key) for the copilot agent. Required only when the
# agent_byok flag is on. 32 random bytes, base64: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# OAUTH 2.1 AUTHORIZATION SERVER (MCP) — required only when the mcp_oauth flag is on
# ----------------------------------------------------------------------------
# The four vars below are all-or-nothing: set all to arm the AS, leave all empty
# to keep it dormant. Discovery still 404s until the mcp_oauth flag is flipped on.
#
# Token audience advertised to MCP clients. MUST byte-match the MCP service's
# MCP_RESOURCE_URL (no trailing slash) or audience validation breaks.
#   prod:  https://mcp.knowtis.app/mcp
#   local: http://localhost:3334/mcp
MCP_RESOURCE_URL=
# CSV of cookie-signing secrets (first is primary; rest allow rotation).
# local: any random secret, e.g. `openssl rand -base64 32`
OAUTH_COOKIE_KEYS=
# Issuer URL of the authorization server (this API). MUST equal the MCP service's
# MCP_OAUTH_ISSUER.
#   prod:  https://api.knowtis.app
#   local: http://localhost:3333
OAUTH_ISSUER=
# Private ES256 JWKS as JSON: { "keys": [ ... ] }. Generate with:
#   npx tsx apps/api/src/scripts/generate-oauth-jwks.ts
# NEVER commit the real value; set the prod value in Railway service variables.
OAUTH_JWKS=

# ----------------------------------------------------------------------------
# DNS (ops only)
# ----------------------------------------------------------------------------
# Porkbun API credentials for managing knowtis.app DNS records (Resend sending
# domain, DMARC). Not read by the API at runtime — kept here so the ops
# credentials live alongside the rest of the environment.
# Create both at https://porkbun.com/account/api — the secret is shown once.
# Domain-level "API ACCESS" must also be toggled ON for the domain.
PORKBUN_API_KEY=pk1_xxxxxxxx
PORKBUN_SECRET_KEY=sk1_xxxxxxxx
