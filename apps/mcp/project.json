{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mcp/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "esbuild apps/mcp/src/index.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist/apps/mcp --packages=external",
          "esbuild apps/mcp/src/stdio.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist/apps/mcp --packages=external"
        ],
        "parallel": true
      },
      "outputs": ["{workspaceRoot}/dist/apps/mcp"]
    },
    "build-mcpb": {
      "executor": "nx:run-commands",
      "options": {
        "command": "esbuild apps/mcp/src/stdio.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/apps/mcp-mcpb/staging/server/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
      }
    },
    "pack-mcpb": {
      "executor": "nx:run-commands",
      "options": { "command": "apps/mcp/scripts/pack-mcpb.sh" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch apps/mcp/src/index.ts",
        "envFile": "apps/mcp/.env"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/mcp/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "apps/mcp/vitest.config.ts",
        "reportsDirectory": "../../coverage/apps/mcp",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/typecheck-project.sh {projectRoot}"
      }
    }
  }
}
