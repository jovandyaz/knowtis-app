API_INTERNAL_URL=http://localhost:3333
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_SERVER_NAME=knowtis-mcp
NODE_ENV=development
PORT=3334

# Set BOTH to enable OAuth resource-server mode: serve RFC 9728 protected-resource
# metadata and an oauth-aware 401 challenge. Leave both empty for legacy API-key-only
# behavior. Setting only one fails fast. MCP_RESOURCE_URL must equal the token audience
# minted by the authorization server (no trailing slash) or audience validation breaks.
MCP_OAUTH_ISSUER=
MCP_RESOURCE_URL=

KNOWTIS_API_KEY=
KNOWTIS_API_URL=http://localhost:3333
