PORT=3334
API_INTERNAL_URL=http://localhost:3333
MCP_SERVER_NAME=knowtis-mcp
MCP_SERVER_VERSION=0.0.1
NODE_ENV=development

# stdio transport (Claude Desktop / IDE MCP clients)
# Preferred alias of API_INTERNAL_URL; the stdio client reads this first.
KNOWTIS_API_URL=http://localhost:3333
# User's MCP key for authenticated tool calls; without it tool calls fail.
KNOWTIS_API_KEY=
