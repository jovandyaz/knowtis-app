API_INTERNAL_URL=http://localhost:3333
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_SERVER_NAME=knowtis-mcp
NODE_ENV=development
PORT=3334

# Set BOTH to enable OAuth resource-server mode: serve RFC 9728 protected-resource
# metadata and an oauth-aware 401 challenge. Leave both empty for legacy API-key-only
# behavior. Setting only one fails fast. This mode is env-gated (independent of the
# API's mcp_oauth flag), so the RS can advertise metadata before the AS goes live.
#
# Issuer of the authorization server (the Knowtis API). MUST equal the API's OAUTH_ISSUER.
#   prod:  https://api.knowtis.app
#   local: http://localhost:3333
MCP_OAUTH_ISSUER=
# This server's canonical resource URL = the token audience. MUST byte-match the API's
# MCP_RESOURCE_URL (no trailing slash) or audience validation breaks.
#   prod:  https://mcp.knowtis.app/mcp
#   local: http://localhost:3334/mcp
MCP_RESOURCE_URL=

KNOWTIS_API_KEY=
KNOWTIS_API_URL=http://localhost:3333
