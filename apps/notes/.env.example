# API Configuration
VITE_API_URL=http://localhost:3333/api/v1
VITE_WS_URL=http://localhost:3333

# Collaboration Mode: 'webrtc' | 'websocket' | 'hybrid'
# - webrtc: Use WebRTC P2P only (current behavior, works offline)
# - websocket: Use WebSocket server only (requires backend)
# - hybrid: Use WebSocket with WebRTC fallback
VITE_COLLABORATION_MODE=webrtc

# PostHog Analytics (leave empty to disable)
# In production, api_host defaults to /ph (Vercel reverse proxy)
# Set VITE_PUBLIC_POSTHOG_HOST only for local dev (e.g., https://us.i.posthog.com)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
