# API Configuration
VITE_API_URL=http://localhost:3333/api/v1

# MCP server URL shown in Settings > Integrations (the connector endpoint users paste
# into Claude/Cursor/VS Code). Defaults to https://mcp.knowtis.app/mcp when unset.
VITE_MCP_URL=http://localhost:3334/mcp
# Hocuspocus collaboration WebSocket base. The frontend appends `/collaboration`
# automatically. Defaults to ws://localhost:3333 when unset.
VITE_WS_URL=http://localhost:3333

# Collaboration Mode: 'webrtc' | 'websocket' | 'hybrid'
# Determines whether the editor connects to the Hocuspocus backend.
# - webrtc: P2P only via y-webrtc (default, works offline, no backend required)
# - websocket: Hocuspocus server only (requires running api with REDIS_URL set for multi-instance)
# - hybrid: Hocuspocus + WebRTC fallback
VITE_COLLABORATION_MODE=webrtc

# PostHog Analytics (leave empty to disable, ignored in dev mode)
# In production, api_host defaults to /t (Vercel reverse proxy)
# Set VITE_PUBLIC_POSTHOG_HOST only if you need a custom PostHog host
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
