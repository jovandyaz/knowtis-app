{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8
  },
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["pnpm", "exec", "nx", "mcp"],
      "enabled": true
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".nx/**",
      ".codegraph/**",
      ".claude/worktrees/**",
      ".worktrees/**",
      "node_modules/**",
      "dist/**",
      "coverage/**"
    ]
  }
}
