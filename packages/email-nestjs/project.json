{
  "name": "email-nestjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/email-nestjs/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:util", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/email-nestjs",
        "main": "packages/email-nestjs/src/index.ts",
        "tsConfig": "packages/email-nestjs/tsconfig.lib.json",
        "assets": ["packages/email-nestjs/*.md"]
      }
    },
    "nx-release-publish": {
      "options": { "packageRoot": "dist/{projectRoot}" }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/packages/email-nestjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash $(git rev-parse --show-toplevel)/tools/typecheck-project.sh",
        "cwd": "{projectRoot}"
      }
    }
  }
}
