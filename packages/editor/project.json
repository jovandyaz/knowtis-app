{
  "name": "editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/editor/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:ui", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/editor",
        "main": "packages/editor/src/index.ts",
        "tsConfig": "packages/editor/tsconfig.lib.json",
        "assets": ["packages/editor/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/packages/editor"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash $(git rev-parse --show-toplevel)/tools/typecheck-project.sh",
        "cwd": "{projectRoot}"
      }
    }
  }
}
